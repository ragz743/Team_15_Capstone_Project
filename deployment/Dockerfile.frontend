# syntax=docker/dockerfile:1
FROM node:20-alpine AS build

WORKDIR /app

COPY code_/frontend/package*.json ./
RUN npm ci

COPY code_/frontend/ ./
RUN npm run build

# admin dashboard, served under /admin/
FROM node:20-alpine AS dashboard

WORKDIR /dashboard

COPY code_/dashboard/package*.json ./
RUN npm ci

COPY code_/dashboard/ ./
RUN npm run build

FROM nginx:alpine

COPY deployment/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
COPY --from=dashboard /dashboard/dist /usr/share/nginx/html/admin

EXPOSE 80
