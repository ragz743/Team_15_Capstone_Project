# syntax=docker/dockerfile:1
FROM node:20-alpine AS build

WORKDIR /app

COPY code/frontend/package*.json ./
RUN npm ci

COPY code/frontend/ ./
RUN npm run build

FROM nginx:alpine

COPY deployment/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80
