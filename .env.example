# OpenRouter - required for the Docker demo.
# The demo key is provided privately by the team and should be rotated after demo day.
OPENROUTER_API_KEY=
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
OPENROUTER_CHAT_MODEL=openrouter/free
# Leave empty to use the chat model for saved history.
OPENROUTER_HISTORY_MODEL=
# Leave empty to use the chat model for the workflow and classifier.
OPENROUTER_WORKFLOW_MODEL=
OPENROUTER_CLASSIFIER_MODEL=
OPENROUTER_CHAT_TEMPERATURE=0

# Postgres / pgvector - required.
PG_USER=awn
PG_PASSWORD=changeme
# PG_HOST and PG_PORT are set automatically by docker-compose for the API container.
# Only override them when running outside Docker against a remote database.

# AWN source database - required for LangGraph weather requests and data loaders.
AWN_DB_USER=
AWN_DB_PASSWORD=
AWN_DB_HOST=

# Optional local_llm compose profile only.
EMBEDDING_MODEL=
CHATBOT_MODEL=
