# OpenRouter - required for the Docker demo.
# The demo key is provided privately by the team and should be rotated after demo day.
OPENROUTER_API_KEY=
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
OPENROUTER_CHAT_MODEL=openai/gpt-oss-20b:free
OPENROUTER_CHAT_TEMPERATURE=0

# Postgres / pgvector - required.
PG_USER=awn
PG_PASSWORD=changeme
# PG_HOST and PG_PORT are set automatically by docker-compose for the API container.
# Only override them when running outside Docker against a remote database.

# AWN source database - only required when running data loaders/indexing.
AWN_DB_USER=
AWN_DB_PASSWORD=
AWN_DB_HOST=

# AgWeatherNet backend (awn_be_v2) - when both are set, chat usage and retrieval quality checks are sent to
# its LLM Usage dashboard (and it sends the monthly budget alert) instead of the local Postgres store.
AWN_BACKEND_URL=
AWN_INTERNAL_KEY=

# Optional local_llm compose profile only.
EMBEDDING_MODEL=
CHATBOT_MODEL=
